{
  "name": "klaus-daimler",
  "version": "0.1.0",
  "description": "A loyal first mate for your codebase. Plans the milestone, ships a PR for each issue, then reviews them with a crew of parallel agents. Wears a red beanie.",
  "license": "MIT",
  "author": "Charlie Jeppsson",
  "homepage": "https://github.com/charliejeppsson/klaus-daimler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliejeppsson/klaus-daimler.git"
  },
  "bugs": "https://github.com/charliejeppsson/klaus-daimler/issues",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "github",
    "tmux",
    "git-worktree",
    "ralph-wiggum",
    "automation"
  ],
  "type": "module",
  "bin": {
    "klaus": "./dist/main.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
